rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin (placeholders for now)
    // In production, checking for a specific custom claim or UID list is better.
    function isAdmin() {
      return request.auth != null; // TEMPORARY: Authenticated users are admins for now
    }

    // Public Read-Only Collections
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /appeals/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /posts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Write Collections (Forms)
    match /applications/{document=**} {
      allow read: if isAdmin();
      allow create: if true; // Public can submit
      allow update, delete: if isAdmin();
    }
    match /contacts/{document=**} {
      allow read: if isAdmin();
      allow create: if true; // Public can submit
      allow update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
